<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LeagueAccountSwitcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeagueAccountSwitcher.Controls"
    xmlns:h="using:LeagueAccountSwitcher.Helpers"
    xmlns:vm="using:LeagueAccountSwitcher.ViewModels">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="League Account Switcher">
            <!-- Not IconSource: its brush doesn't follow a theme change. -->
            <TitleBar.LeftHeader>
                <FontIcon
                    Margin="16,0,0,0"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE748;"
                    IsHitTestVisible="False" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <Grid Grid.Row="1" Padding="16,4,16,8" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <AutoSuggestBox
                AutomationProperties.Name="Search accounts"
                PlaceholderText="Search Riot ID, nickname or region"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <SplitButton
                Grid.Column="1"
                AutomationProperties.Name="Sync"
                Command="{x:Bind ViewModel.SyncCommand}"
                IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                ToolTipService.ToolTip="Read the signed-in account from League Client">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE895;" />
                    <TextBlock Text="Sync" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Command="{x:Bind ViewModel.SyncCommand}" Text="Sync from League Client" />
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.RefreshAllCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRefreshApi, Mode=OneWay}"
                            Text="Refresh All via Riot API" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>

            <Button
                Grid.Column="2"
                Width="36"
                Height="32"
                Padding="0"
                AutomationProperties.Name="Settings"
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>

            <Button
                Grid.Column="3"
                AutomationProperties.Name="Add Account"
                Command="{x:Bind ViewModel.AddAccountCommand}"
                IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Add Account" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8">
                <ComboBox
                    MinWidth="132"
                    AutomationProperties.Name="Filter by region"
                    ItemsSource="{x:Bind ViewModel.Regions}"
                    SelectedItem="{x:Bind ViewModel.SelectedRegion, Mode=TwoWay}" />
                <ComboBox
                    MinWidth="152"
                    AutomationProperties.Name="Sort accounts"
                    SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                    ToolTipService.ToolTip="Sort accounts">
                    <x:String>Last Used</x:String>
                    <x:String>Rank (Highest)</x:String>
                    <x:String>Level</x:String>
                    <x:String>Name</x:String>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ProgressBar
            Grid.Row="2"
            Margin="16,0"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <ScrollViewer Grid.Row="3">
            <Grid Padding="16,4,16,16">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Accounts}" VerticalAlignment="Top">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountItemViewModel">
                            <controls:AccountCard Account="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Border
                    MaxWidth="480"
                    Margin="0,16,0,0"
                    Padding="32,24"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <controls:RankEmblemControl Width="72" Height="72" Tier="GOLD" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Your accounts, one click apart" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Switching swaps saved Riot sessions: you stay signed in, 2FA works, and no passwords are stored."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            MinWidth="220"
                            MinHeight="40"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.AddAccountCommand}"
                            Content="Add Your First Account"
                            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.ShowNoMatches, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="No accounts match" />
                    <HyperlinkButton
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.ClearFiltersCommand}"
                        Content="Clear filters" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="4" Padding="16,4,16,8" Visibility="{x:Bind ViewModel.IsBannerOpen, Mode=OneWay}">
            <InfoBar
                IsClosable="{x:Bind h:Ui.Not(ViewModel.IsBusy), Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.IsBannerOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.BannerSeverity, Mode=OneWay}" />
        </Grid>

        <Grid
            Grid.Row="5"
            Padding="16,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel AutomationProperties.LiveSetting="Polite" Orientation="Horizontal" Spacing="8">
                <Grid Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                    <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                HorizontalAlignment="Right"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
