<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LeagueAccountSwitcher.Controls.AccountCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeagueAccountSwitcher.Controls"
    xmlns:h="using:LeagueAccountSwitcher.Helpers">

    <Border Style="{StaticResource CardStyle}" Padding="14,12">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="48" Height="48">
                <PersonPicture
                    Width="48"
                    Height="48"
                    AutomationProperties.AccessibilityView="Raw"
                    Initials="{x:Bind Account.Initials, Mode=OneWay}"
                    ProfilePicture="{x:Bind h:Ui.Avatar(Account.AvatarPath), Mode=OneWay}" />
                <Ellipse
                    Width="14"
                    Height="14"
                    Margin="0,0,-2,-2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                    Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    StrokeThickness="2"
                    Visibility="{x:Bind Account.IsActive, Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap">
                    <Run Text="{x:Bind Account.Title, Mode=OneWay}" /><Run Text="{x:Bind Account.Tag, Mode=OneWay}" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Account.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind h:Ui.VisibleIfText(Account.Subtitle), Mode=OneWay}" />

                <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="4">
                    <Border
                        Style="{StaticResource PillStyle}"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                        <TextBlock
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Style="{StaticResource PillTextStyle}"
                            Text="{x:Bind Account.Region, Mode=OneWay}" />
                    </Border>
                    <Border Style="{StaticResource PillStyle}">
                        <TextBlock Style="{StaticResource PillTextStyle}" Text="{x:Bind Account.Level, Mode=OneWay}" />
                    </Border>
                    <Border
                        Style="{StaticResource PillStyle}"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        Visibility="{x:Bind Account.IsActive, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource PillTextStyle}"
                            Text="Active" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Grid
                Grid.Column="2"
                Background="Transparent"
                ColumnSpacing="8"
                ToolTipService.ToolTip="{x:Bind Account.SyncedText, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:RankEmblemControl Tier="{x:Bind Account.Tier, Mode=OneWay}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Solo/Duo" />
                    <TextBlock
                        Foreground="{x:Bind controls:TierPalette.TextBrush(Account.Tier, ActualTheme), Mode=OneWay}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Account.Rank, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Account.WinLoss, Mode=OneWay}"
                        Visibility="{x:Bind h:Ui.VisibleIfText(Account.WinLoss), Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                <Button
                    MinWidth="80"
                    AutomationProperties.HelpText="{x:Bind Account.ActionHint, Mode=OneWay}"
                    Command="{x:Bind Account.SwitchCommand, Mode=OneWay}"
                    Content="{x:Bind Account.ActionText, Mode=OneWay}"
                    IsEnabled="{x:Bind Account.Owner.CanInteract, Mode=OneWay}"
                    Style="{x:Bind h:Ui.ActionStyle(Account.IsRunning), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Account.ActionHint, Mode=OneWay}" />
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="More actions"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    IsEnabled="{x:Bind Account.Owner.CanInteract, Mode=OneWay}"
                    ToolTipService.ToolTip="More actions">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind Account.RecaptureCommand, Mode=OneWay}" Text="Re-capture Current Session">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind Account.RefreshCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind Account.Owner.CanRefreshApi, Mode=OneWay}"
                                Text="Refresh via Riot API">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Account.EditCommand, Mode=OneWay}" Text="Edit Details">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Command="{x:Bind Account.RemoveCommand, Mode=OneWay}" Text="Remove Account">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
