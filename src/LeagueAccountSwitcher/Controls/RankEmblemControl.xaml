<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LeagueAccountSwitcher.Controls.RankEmblemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="48"
    Height="48"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">

    <!-- All geometry shares a 64 x 64 grid. Higher tiers add wings, then a crown, then rays. -->
    <Viewbox>
        <Canvas Width="64" Height="64">
            <Path x:Name="Rays" Opacity="0.7"
                  Data="M32,36 L9,4 L22,36 Z M32,36 L55,4 L42,36 Z M32,36 L3,56 L27,44 Z M32,36 L61,56 L37,44 Z" />

            <Path x:Name="SmallWings" StrokeThickness="1" StrokeLineJoin="Round"
                  Data="M15,24 L4,20 L8,30 L6,31 L15,42 Z M49,24 L60,20 L56,30 L58,31 L49,42 Z" />
            <Path x:Name="LargeWings" StrokeThickness="1" StrokeLineJoin="Round"
                  Data="M15,18 L1,10 L3,19 L7,22 L2,22 L6,31 L10,32 L6,34 L15,46 Z M49,18 L63,10 L61,19 L57,22 L62,22 L58,31 L54,32 L58,34 L49,46 Z" />

            <Path x:Name="Crown" StrokeThickness="1" StrokeLineJoin="Round"
                  Data="M19,14 L17,2 L26,8 L32,0 L38,8 L47,2 L45,14 L32,9 Z" />

            <Path x:Name="Shield" StrokeThickness="1.5" StrokeLineJoin="Round"
                  Data="M32,10 L49,16 V34 C49,46 42,55 32,62 C22,55 15,46 15,34 V16 Z" />
            <Path x:Name="ShieldFacet" Opacity="0.35"
                  Data="M32,10 L49,16 V34 C49,46 42,55 32,62 Z" />
            <Path x:Name="Field" StrokeThickness="1" StrokeLineJoin="Round"
                  Data="M32,15 L45,20 V34 C45,43 39,51 32,57 C25,51 19,43 19,34 V20 Z" />
            <Path x:Name="Sigil" />
        </Canvas>
    </Viewbox>
</UserControl>
