<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LeagueAccountSwitcher.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:LeagueAccountSwitcher.Helpers"
    Title="Settings"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Opened="OnOpened"
    PrimaryButtonClick="OnPrimary"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Width="460" Spacing="20">
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind h:Ui.HasText(ViewModel.Error), Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error" />

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Riot Client" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DetectedRiotPath, Mode=OneWay}" />
            <TextBox
                AutomationProperties.Name="Riot Client path override"
                PlaceholderText="Optional path to RiotClientServices.exe"
                Text="{x:Bind ViewModel.RiotPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="League Client" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DetectedLeaguePath, Mode=OneWay}" />
            <TextBox
                AutomationProperties.Name="League Client path override"
                PlaceholderText="Optional League of Legends install folder"
                Text="{x:Bind ViewModel.LeaguePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox HorizontalAlignment="Stretch" Header="After switching, launch" SelectedIndex="{x:Bind ViewModel.LaunchIndex, Mode=TwoWay}">
                <x:String>League of Legends</x:String>
                <x:String>Riot Client Only</x:String>
            </ComboBox>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Header="Theme" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                <x:String>System</x:String>
                <x:String>Dark</x:String>
                <x:String>Light</x:String>
            </ComboBox>
        </Grid>

        <ToggleSwitch
            Header="Auto-sync level, rank and region from League Client"
            IsOn="{x:Bind ViewModel.AutoSync, Mode=TwoWay}" />

        <ToggleSwitch
            Header="Keep running in system tray when closed"
            IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />

        <StackPanel Spacing="4">
            <PasswordBox
                Header="Riot Developer API key (optional)"
                Password="{x:Bind ViewModel.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="RGAPI-…" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Not needed: auto-sync works without a key. A key only adds refreshing accounts you aren't signed in to. It's stored encrypted for your Windows user."
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
