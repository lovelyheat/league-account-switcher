<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LeagueAccountSwitcher.Views.AddAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeagueAccountSwitcher.Controls"
    xmlns:h="using:LeagueAccountSwitcher.Helpers"
    Title="Add account"
    CloseButtonText="Cancel"
    Closing="OnClosing"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
    Opened="OnOpened"
    PrimaryButtonClick="OnPrimary"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Width="460" Spacing="12">
        <SelectorBar IsEnabled="{x:Bind h:Ui.Not(ViewModel.IsBusy), Mode=OneWay}" SelectionChanged="OnModeChanged">
            <SelectorBarItem IsSelected="True" Text="Capture Current Session" />
            <SelectorBarItem x:Name="SignInTab" Text="Sign In to New Account" />
        </SelectorBar>

        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind h:Ui.HasText(ViewModel.Message), Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />

        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsCaptureMode, Mode=OneWay}">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Saves the account that's signed in to Riot Client on this PC. No password is stored."
                TextWrapping="Wrap" />
            <controls:AccountDetailsEditor
                Details="{x:Bind ViewModel.Details, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowDetails, Mode=OneWay}" />
            <HyperlinkButton
                Padding="0,4"
                Command="{x:Bind ViewModel.DetectCommand}"
                Content="Check again"
                IsEnabled="{x:Bind h:Ui.Not(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsSignInMode, Mode=OneWay}">
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="1. Open a clean login" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Backs up the current saved account, closes League and Riot Client, then opens a fresh Riot login screen."
                        TextWrapping="Wrap" />
                    <Button
                        Command="{x:Bind ViewModel.OpenLoginCommand}"
                        Content="{x:Bind ViewModel.OpenLoginText, Mode=OneWay}"
                        IsEnabled="{x:Bind h:Ui.Not(ViewModel.IsBusy), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="2. Sign in, then capture" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                        <Run Text="In Riot Client, check" />
                        <Run FontWeight="SemiBold" Text="Stay signed in" />
                        <Run Text="and sign in (2FA works). Then come back and select Capture New Session." />
                    </TextBlock>
                    <TextBox
                        Header="Nickname (optional)"
                        IsEnabled="{x:Bind ViewModel.IsLoginOpen, Mode=OneWay}"
                        MaxLength="32"
                        Text="{x:Bind ViewModel.Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</ContentDialog>
